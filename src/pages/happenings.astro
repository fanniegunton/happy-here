---
import Layout from '@components/astro/Layout.astro';
import HappeningsPage from '@components/react/HappeningsPage';
import { getAllEstablishments } from '@lib/sanity';

// Fetch data at build time
const establishments = await getAllEstablishments();

// Filter test establishment in production
const filteredEstablishments = import.meta.env.PROD
  ? establishments.filter((est) => est._id !== 'b95f53fc-ae57-4605-b4b6-6ceb785a1756')
  : establishments;
---

<Layout title="Happenings - Happy Here">
  {/*
    Client-side React component handles:
    - Flattening each establishment's otherDeals into one tile per deal
    - Filter state management
    - Search functionality
    - Real-time deal-status checking
    - Dynamic rendering
  */}
  <HappeningsPage establishments={filteredEstablishments} client:load />
</Layout>
